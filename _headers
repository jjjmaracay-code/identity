/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

# El propio archivo del Service Worker nunca debe servirse desde una
# caché intermedia (CDN o del navegador) -- si quedara una copia vieja
# cacheada en el camino, el mecanismo de actualización del navegador
# (que compara bytes contra /sw.js en cada comprobación) nunca detectaría
# una versión nueva, sin importar cuántas veces se cierre y abra la app.
/sw.js
  Cache-Control: no-cache

# /diag.html es una página temporal de diagnóstico (se borrará al acabar
# el diagnóstico): nunca debe servirse desde una caché intermedia (CDN o
# del navegador), para que siempre refleje el estado real del dispositivo
# en el momento de la visita, igual que /sw.js arriba. No se toca
# X-Frame-Options ni frame-ancestors: la prueba "Probar index.html" abre
# una pestaña nueva en vez de un iframe precisamente para no necesitar
# debilitar esa protección contra clickjacking en ningún archivo.
/diag.html
  Cache-Control: no-store
